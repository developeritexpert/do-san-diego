{% extends "_layouts/main.twig" %}

{% set title = entry.title %}

{% block content %}
<article class="restaurant-detail container">
    <header class="entry-header">
        <h1>{{ entry.title }}</h1>
        <p class="meta">
            {% if entry.cuisineType is defined and entry.cuisineType.one() %}
                <span>{{ entry.cuisineType.one().title }}</span>
            {% endif %}
            {% if entry.neighborhood is defined %}
                &bull; <span>{{ entry.neighborhood }}</span>
            {% endif %}
        </p>
    </header>

    {% if entry.featuredImage is defined and entry.featuredImage.one() %}
        <div class="entry-hero-image">
            <img src="{{ entry.featuredImage.one().getUrl() }}" alt="{{ entry.title }}" />
        </div>
    {% endif %}

    <div class="entry-body">
        {{ entry.body ?? '' }}
    </div>
</article>
{% endblock %}
