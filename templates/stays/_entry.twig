{% extends "_layouts/main.twig" %}

{% set title = entry.title %}

{% block content %}
<article class="stay-detail container">
    <header class="entry-header">
        <h1>{{ entry.title }}</h1>
        {% if entry.pricePerNight is defined %}
            <p class="price-tag">${{ entry.pricePerNight }} / night</p>
        {% endif %}
    </header>

    {% if entry.featuredImage is defined and entry.featuredImage.one() %}
        <div class="entry-hero-image">
            <img src="{{ entry.featuredImage.one().getUrl() }}" alt="{{ entry.title }}" />
        </div>
    {% endif %}

    <div class="entry-body">
        {{ entry.body ?? '' }}
    </div>
</article>
{% endblock %}
