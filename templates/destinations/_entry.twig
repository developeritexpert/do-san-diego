{% extends '_layouts/main.twig' %}
{% block content %}
	{% set ppBgImage = getenv('PRIMARY_SITE_URL') ~ 'assets/images/pp-bg1.png'
%}
	<section class="single-list-sec" style="background-image: url('{{ ppBgImage }}')">
		<div class="container">
			<div class="single-list-hero">
				{% set titleWords = (entry.heading ?? entry.title)|split(' ') %}
				{% set lastWord = titleWords|last %}
				{% set mainTitle =
			titleWords|slice(0, (titleWords|length) - 1)|join(' ')
			%}
				<h1>
					{{ mainTitle }}
					<span class="span-orange">{{ lastWord }}</span>
				</h1>
				<div class="single-list-hero-slide">
					<div class="listing-slider">
						{% set heroImages = entry.featuredImage.all() %}
						{% if heroImages|length %}
							{% for img in heroImages %}
								<div class="listing-slide {{
																		loop.first
																			? 'active'
																			: ''
																		}}" data-index="{{ loop.index0 }}">
									<img src="{{ img.url }}" alt="{{ img.title ?? entry.title }}"/>
								</div>
							{% endfor %}
						{% else %}
							<div class="listing-slide active" data-index="0">
								<img src="{{ getenv( 'PRIMARY_SITE_URL' ) }}assets/images/single-list-img1.png" alt="Resort exterior"/>
							</div>
						{% endif %}
					</div>

					<div class="listing-progress-bar">
						<div class="listing-progress-fill"></div>
					</div>

					<div class="listing-slider-footer">
						<div class="listing-arrows">
							<button class="listing-prev">
								<img src="{{ getenv( 'PRIMARY_SITE_URL' ) }}assets/images/left-arrow.svg" alt=""/>
							</button>
							<button class="listing-next">
								<img src="{{ getenv( 'PRIMARY_SITE_URL' ) }}assets/images/right-arrow.svg" alt=""/>
							</button>
						</div>
						<div class="listing-counter">
							<span class="current-slide">1</span>
							<span class="sep">/</span>
							<span class="total-slides">
								{{ (heroImages|length) > 0
							? heroImages|length
							: 1 }}
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	{% set coastBgImage = getenv('PRIMARY_SITE_URL')
~ 'assets/images/single-list-bg2.png'
%}
