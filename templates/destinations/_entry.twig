								<div style="height: 100%; min-height: 200px; display: flex; align-items: center; justify-content: center; background: #e0e0e0;">
									No Image
								</div>
							{% endif %}
						</div>
						<span class="listing-badge">
							Listing #{{ loop.index + 1 }}
						</span>
						<h4>
							{{ rel.heading ?? rel.title }}
						</h4>
						<p>
							{{ rel.description|striptags }}
						</p>
						<a href="{{ rel.url }}" class="view-details-btn">
							{{ rel.buttonText ?? 'View Details' }}
						</a>
					</div>
				{% endfor %}
			</div>

