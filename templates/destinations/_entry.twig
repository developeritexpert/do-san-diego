							{{
					entry.description
					|replace({ '<p>': '
					<p class="pb-20">' })
						|raw
						}}
						</div>
					{% endif %}

					<div class="coast-sec-left-boxes">
						<div class="coast-sec-left-boxes">
							<div class="coast-sec-left-box">
								<h5>
									Amenities included
								</h5>
								{% set allAmenities = [] %}
								{% if
							entry.amenitiesIncluded is defined
							and entry.amenitiesIncluded %}
									{% for row in entry.amenitiesIncluded %}
										{% if
							row.col1|default(
							''
							) %}
											{% set allAmenities =
							allAmenities|merge([row.col1])
							%}
										{% endif %}
										{% if
							row.col2|default(
							''
							) %}
											{% set allAmenities =
							allAmenities|merge([row.col2])
							%}
										{% endif %}
										{% if
							row.col3|default(
							''
							) %}
											{% set allAmenities =
							allAmenities|merge([row.col3])
							%}
										{% endif %}
									{% endfor %}
								{% endif %}

								{% if allAmenities|length %}
									{% set perCol =
							((allAmenities|length) / 3)|round(
							0,
							'ceil'
							)
							%}
									{% set cols =
							allAmenities|batch(max(1, perCol))
							%}
									<div class="amenities-grid">
										{% for col in cols %}
											<ul class="amenities-col">
												{% for item in col %}
													<li class="amenity-item">
														<span class="check-icon"></span>
														{{ item }}
													</li>
												{% endfor %}
											</ul>
										{% endfor %}
									</div>
								{% endif %}
							</div>
						</div>

						<div class="coast-sec-left-box">
							<h5>
								Things to Do Nearby
