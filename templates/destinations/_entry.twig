{% block head %}
	<!-- Swiper CSS -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
{% endblock %}

{% block scripts %}
	<!-- Swiper JS -->
	<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
initListingSlider();
initReviewSlider();
});

function initListingSlider() {
const container = document.querySelector('.listing-slider');
if (! container) 
return;

const slides = container.querySelectorAll('.listing-slide');
const nextBtn = document.querySelector('.listing-next');
const prevBtn = document.querySelector('.listing-prev');
const currentCounter = document.querySelector('.listing-counter .current-slide');
const progressFill = document.querySelector('.listing-progress-fill');

if (! slides.length) 
return;

let activeIndex = 0;

// Find initial active index
slides.forEach((slide, index) => {
if (slide.classList.contains('active')) {
activeIndex = index;
}
});

function goTo(index) {
if (index < 0 || index >= slides.length) 
return;

activeIndex = index;

// Toggle active class
slides.forEach((slide, idx) => {
slide.classList.toggle('active', idx === activeIndex);
});

// Update counter
if (currentCounter) {
currentCounter.textContent = activeIndex + 1;
}

// Update progress fill
if (progressFill) {
progressFill.style.width = ((activeIndex + 1) / slides.length) * 100 + '%';
}

// Calculate translation
if (activeIndex === 0) {
container.style.transform = 'translateX(0px)';
} else {
const containerWidth = container.parentElement.offsetWidth;
const gap = 10; // gap: 10px from CSS
const inactiveSlideWidth = containerWidth * 0.33;
const translatePx = (activeIndex - 1) * (inactiveSlideWidth + gap);
container.style.transform = `translateX(-${translatePx}px)`;
}
}

if (nextBtn) {
nextBtn.addEventListener('click', () => {
if (activeIndex < slides.length - 1) {
goTo(activeIndex + 1);
} else {
goTo(0);
}
});
}

if (prevBtn) {
prevBtn.addEventListener('click', () => {
if (activeIndex > 0) {
goTo(activeIndex - 1);
} else {
goTo(slides.length - 1);
}
});
}

container.style.transition = 'transform 0.35s ease';

window.addEventListener('resize', () => {
goTo(activeIndex);
});

goTo(activeIndex);
}

function initReviewSlider() {
const swiperContainer = document.querySelector('.review-slider');
if (! swiperContainer) 
return;


new Swiper('.review-slider', {
slidesPerView: 1,
spaceBetween: 30,
loop: true,
navigation: {
nextEl: '.review-next',
prevEl: '.review-prev'
}
});
}
	</script>
{% endblock %}
