{% extends '_layouts/main.twig' %}

{% block content %}
	<section class="pp-sec">
		<div class="pp-content">
			<div class="pp-div1" style="background-image: url('{{ getenv('PRIMARY_SITE_URL') }}assets/images/pp-bg1.png')">
				<div class="container">
					<div class="pp-title">
						<h1>{{ entry.title ?? 'Privacy Policy' }}</h1>
					</div>

					<div class="pp-point">

						{% if entry.description is defined and entry.description %}
							{{ entry.description|raw }}
						{% else %}
							<p>
								We are committed to protecting your personal information and
																              ensuring your experience on our website is safe, secure, and
																              transparent. This Privacy Policy explains what information we
																              collect, how we use it, and the choices you have regarding
																              your data.
							</p>
						{% endif %}
					</div>

					<div class="pp-point">
						<h4>Information We Collect</h4>
						{% if entry.description2 is defined and entry.description2 %}
							{{ entry.description2|raw }}
						{% else %}
							<p>
								We are committed to protecting your personal information and
																              ensuring your experience on our website is safe, secure, and
																              transparent. This Privacy Policy explains what information we
																              collect, how we use it, and the choices you have regarding
																              your data.
							</p>
						{% endif %}

						<ul class="pp-list">
							{% if entry.listData is defined and entry.listData.exists() %}
								{% for block in entry.listData.all() %}
									<li>{{ block.description }}</li>
								{% endfor %}
							{% else %}
								<li>Personal information such as your name, email address, and phone number when you contact us or submit a listing inquiry.</li>
								<li>Booking or reservation details when using our services.</li>
								<li>Information you provide through contact forms or newsletter subscriptions.</li>
								<li>Device information including browser type, operating system, IP address, and pages visited</li>
								<li>Cookies and similar technologies that help improve website performance and user experience.</li>
							{% endif %}
						</ul>
					</div>
				</div>
			</div>

			<div class="pp-div2" style="background-image: url('{{ getenv('PRIMARY_SITE_URL') }}assets/images/pp-bg2.png')">
				<div class="absolute-txt-img">
					<img src="{{ getenv('PRIMARY_SITE_URL') }}assets/images/DO-San-Diego.png" alt=""/>
				</div>
				<div class="container">
					<div class="pp-point">
						<h4>{{ entry.heading ?? 'How We Use Your Information' }}</h4>
						{% if entry.description3 is defined and entry.description3 %}
							{{ entry.description3|raw }}
						{% else %}
							<p>The information we collect may be used to:</p>
						{% endif %}
						<ul class="pp-list">
							{% if entry.listdata2 is defined and entry.listdata2.exists() %}
								{% for block in entry.listdata2.all() %}
									<li>{{ block.description }}</li>
								{% endfor %}
							{% else %}
								<li>Respond to your inquiries and customer support requests.</li>
								<li>Process reservations, bookings, or listing submissions.</li>
								<li>Improve our website, services, and user experience.</li>
								<li>Send updates, newsletters, or promotional communications (only if you have opted in).</li>
								<li>Monitor website performance and security.</li>
								<li>Comply with legal obligations.</li>
							{% endif %}
						</ul>
					</div>

					<div class="pp-point">

						{% if entry.description4 is defined and entry.description4 %}
							<div class="pb-20">{{ entry.description4|raw }}</div>
						{% else %}
							<p class="pb-20">
								Our website uses cookies to enhance your browsing experience.
																              Cookies help us understand how visitors interact with our
																              website, remember user preferences, and improve website
																              functionality.
							</p>
						{% endif %}

						{% if entry.description5 is defined and entry.description5 %}
							<div class="pp-cookies">{{ entry.description5|raw }}</div>
						{% else %}
							<p class="pp-cookies">
								You may disable cookies through your browser settings;
																              however, some features of the website may not function
																              properly.
							</p>
						{% endif %}
					</div>
				</div>
			</div>

			<div class="pp-div3">
				<div class="container">
					<div class="pp-point">

						{% if entry.description6 is defined and entry.description6 %}
							{{ entry.description6|raw }}
						{% else %}
							<p>
								We may use trusted third-party providers to help operate our
																              website and services, including:
							</p>
						{% endif %}
						<ul class="pp-list">
							{% if entry.listdata3 is defined and entry.listdata3.exists() %}
								{% for block in entry.listdata3.all() %}
									<li>{{ block.description }}</li>
								{% endfor %}
							{% else %}
								<li>Analytics providers</li>
								<li>Payment processors</li>
								<li>Booking platforms</li>
								<li>Email marketing services</li>
								<li>Interactive maps</li>
								<li>Social media integrations</li>
							{% endif %}
						</ul>
						{% if entry.description7 is defined and entry.description7 %}
							{{ entry.description7|raw }}
						{% else %}
							<p>
								These providers only receive the information necessary to
																              perform their services and are required to protect your data.
							</p>
						{% endif %}
					</div>

					<div class="pp-point">
						<h4>Information Sharing</h4>
						{% if entry.richText4 is defined and entry.richText4 %}
							<div class="pb-20">{{ entry.richText4|raw }}</div>
						{% else %}
							<p class="pb-20">We respect your privacy and do not sell your personal information.</p>
							<p>We may share your information only when:</p>
						{% endif %}

						<ul class="pp-list">
							{% if entry.listdata4 is defined and entry.listdata4.exists() %}
								{% for block in entry.listdata4.all() %}
									<li>{{ block.description }}</li>
								{% endfor %}
							{% else %}
								<li>Required by law.</li>
								<li>Necessary to complete a booking or requested service.</li>
								<li>Working with trusted service providers that assist in operating our website.</li>
								<li>Protecting our legal rights, users, or property.</li>
							{% endif %}
						</ul>
					</div>

					<div class="pp-point">

						{% if entry.description11 is defined and entry.description11 %}
							{{ entry.description11|raw }}
						{% else %}
							<p>
								We implement reasonable technical and organizational measures
																              to safeguard your personal information against unauthorized
																              access, disclosure, alteration, or destruction. While we
																              strive to protect your data, no method of internet
																              transmission or electronic storage is completely secure.
							</p>
						{% endif %}
					</div>

					<div class="pp-point">

						{% if entry.description12 is defined and entry.description12 %}
							{{ entry.description12|raw }}
						{% else %}
							<p>Depending on your location, you may have the right to:</p>
						{% endif %}
						<ul class="pp-list">
							{% if entry.listdata5 is defined and entry.listdata5.exists() %}
								{% for block in entry.listdata5.all() %}
									<li>{{ block.description }}</li>
								{% endfor %}
							{% else %}
								<li>Access your personal information.</li>
								<li>Correct inaccurate information.</li>
								<li>Request deletion of your personal data.</li>
								<li>Withdraw consent for marketing communications.</li>
								<li>Request a copy of the information we hold about you.</li>
								<li>Object to certain processing activities.</li>
							{% endif %}
						</ul>
					</div>

					<div class="pp-point">

						{% if entry.description13 is defined and entry.description13 %}
							{{ entry.description13|raw }}
						{% else %}
							<p>
								We retain personal information only for as long as necessary
																              to fulfill the purposes described in this Privacy Policy,
																              comply with legal obligations, resolve disputes, and enforce
																              our agreements.
							</p>
						{% endif %}
					</div>

					<div class="pp-point">

						{% if entry.description14 is defined and entry.description14 %}
							{{ entry.description14|raw }}
						{% else %}
							<p>
								Our website is not intended for children under the age of 13.
																              We do not knowingly collect personal information from
																              children. If you believe a child has provided personal
																              information, please contact us so we can promptly remove it.
							</p>
						{% endif %}
					</div>

					<div class="pp-point">

						{% if entry.description15 is defined and entry.description15 %}
							{{ entry.description15|raw }}
						{% else %}
							<p>
								Our website may contain links to third-party websites for your
																              convenience. We are not responsible for the privacy practices
																              or content of those external websites. We encourage you to
																              review their privacy policies before providing any personal
																              information.
							</p>
						{% endif %}
					</div>

					<div class="pp-point">

						{% set layout = entry.getFieldLayout() %}
						{% if layout.getFieldByHandle('description16') and entry.description16 %}
							{{ entry.description16|raw }}
						{% else %}
							<p>
								We may update this Privacy Policy from time to time to reflect
																              changes in our services, legal requirements, or business
																              practices. Any updates will be posted on this page along with
																              the revised effective date.
							</p>
						{% endif %}
					</div>

					<div class="pp-point">

						{% if layout.getFieldByHandle('description17') and entry.description17 %}
							{{ entry.description17|raw }}
						{% else %}
							<p>
								If you have any questions about this Privacy Policy or how
																              your information is handled, please contact us.
							</p>
						{% endif %}
						<div class="pp-contact">
							{% set em = entry.email ?? 'privacy@example.com' %}
							<a href="mailto:{{ em }}">
								<span class="pp-span">Email:</span>
								{{ em }}</a>
							{% set ph = entry.phoneNumber ?? '(520) 229-4700' %}
							<a href="tel:{{ ph|replace({' ': '', '(': '', ')': '', '-': ''}) }}">
								<span class="pp-span">Phone:</span>
								{{ ph }}</a>
							{% set adr = entry.address ?? 'Town Of Oro Valley, 11000 N. La Cañada Drive, Oro Valley, AZ 85737' %}
							<a href="#">
								<span class="pp-span">Address:</span>
								{{ adr|nl2br }}</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	{% include '_components/matrix/stayGrid.twig' with {
		block: { heading: 'Where to Eat', buttonUrl: siteUrl('restaurants') }
	} %}

	{% include '_components/matrix/block-bottomCta.twig' with {
		block: { heading: 'Where to Eat', buttonUrl: siteUrl('restaurants') }
	} %}

{% endblock %}
