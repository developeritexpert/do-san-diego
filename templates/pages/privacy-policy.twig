{% extends '_layouts/main.twig' %}

{% block content %}
	<section class="pp-sec">
		<div class="pp-content">
			<div class="pp-div1" style="background-image: url('{{ getenv('PRIMARY_SITE_URL') }}assets/images/pp-bg1.png')">
				<div class="container">
					<div class="pp-title">
						<h1>{{ entry.title }}</h1>
					</div>

					<div class="pp-point">
						{{ entry.description ?? '' }}
					</div>

					<div class="pp-point">
						{{ entry.description2 ?? '' }}
						{% if entry.listData is defined and entry.listData.exists() %}
							<ul class="pp-list">
								{% for block in entry.listData.all() %}
									<li>{{ block.description }}</li>
								{% endfor %}
							</ul>
						{% endif %}
					</div>
				</div>
			</div>

			<div class="pp-div2" style="background-image: url('{{ getenv('PRIMARY_SITE_URL') }}assets/images/pp-bg2.png')">
				<div class="absolute-txt-img">
					<img src="{{ getenv('PRIMARY_SITE_URL') }}assets/images/DO-San-Diego.png" alt=""/>
				</div>
				<div class="container">
					<div class="pp-point">
						<h4>{{ entry.heading ?? 'How We Use Your Information' }}</h4>
						{{ entry.description3 ?? '' }}
						{% if entry.listdata2 is defined and entry.listdata2.exists() %}
							<ul class="pp-list">
								{% for block in entry.listdata2.all() %}
									<li>{{ block.description }}</li>
								{% endfor %}
							</ul>
						{% endif %}
					</div>

					<div class="pp-point">
						<div class="pb-20">
							{{ entry.description4 ?? '' }}
						</div>
						<div class="pp-cookies">
							{{ entry.description5 ?? '' }}
						</div>
					</div>
				</div>
			</div>

			<div class="pp-div3">
				<div class="container">
					<div class="pp-point">
						{{ entry.description6 ?? '' }}


						{% if entry.listdata3 is defined and entry.listdata3.exists() %}
							<ul class="pp-list">
								{% for block in entry.listdata3.all() %}
									<li>{{ block.description }}</li>
								{% endfor %}
							</ul>
						{% endif %}
						{{ entry.description7 ?? '' }}
						{{ entry.description8 ?? '' }}
					</div>

					<div class="pp-point">

						<div class="pb-20">
							{{ entry.richText4 ?? '' }}
						</div>
						{% if entry.listdata4 is defined and entry.listdata4.exists() %}
							<ul class="pp-list">
								{% for block in entry.listdata4.all() %}
									<li>{{ block.description }}</li>
								{% endfor %}
							</ul>
						{% endif %}
						{{ entry.description9 ?? '' }}
						{{ entry.description10 ?? '' }}
					</div>

					<div class="pp-point">

						{% if entry.listdata5 is defined and entry.listdata5.exists() %}
							<ul class="pp-list">
								{% for block in entry.listdata5.all() %}
									<li>{{ block.description }}</li>
								{% endfor %}
							</ul>
						{% endif %}
					</div>

					<div class="pp-point">

						{{ entry.description11 ?? '' }}
						{{ entry.description12 ?? '' }}
					</div>

					<div class="pp-point">

						{{ entry.description13 ?? '' }}
					</div>

					<div class="pp-point">

						{{ entry.description14 ?? '' }}
					</div>

					<div class="pp-point">

						{{ entry.description15 ?? '' }}
					</div>


					<div class="pp-point">
						<div class="pp-contact">
							{% if entry.email is defined and entry.email %}
								<a href="mailto:{{ entry.email }}">
									<span class="pp-span">Email:</span>
									{{ entry.email }}
								</a>
							{% endif %}
							{% if entry.phoneNumber is defined and entry.phoneNumber %}
								<a href="tel:{{ entry.phoneNumber|replace({' ': '', '(': '', ')': '', '-': ''}) }}">
									<span class="pp-span">Phone:</span>
									{{ entry.phoneNumber }}
								</a>
							{% endif %}
							{% if entry.address is defined and entry.address %}
								<a href="#">
									<span class="pp-span">Address:</span>
									{{ entry.address|nl2br }}
								</a>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}
