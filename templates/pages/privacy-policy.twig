{% extends '_layouts/main.twig' %}

{% block content %}
	<section class="pp-sec">
		<div class="pp-content">
			<div class="pp-div1" style="background-image: url('{{ getenv('PRIMARY_SITE_URL') }}assets/images/pp-bg1.png')">
				<div class="container">
					<div class="pp-title">
						<h1>{{ entry.title }}</h1>
					</div>

					<div class="pp-point">
						{{ entry.description }}
					</div>

					<div class="pp-point">
						{{ entry.description2 }}
						{{ entry.listData }}
					</div>
				</div>
			</div>

			<div class="pp-div2" style="background-image: url('{{ getenv('PRIMARY_SITE_URL') }}assets/images/pp-bg2.png')">
				<div class="absolute-txt-img">
					<img src="{{ getenv('PRIMARY_SITE_URL') }}assets/images/DO-San-Diego.png" alt=""/>
				</div>
				<div class="container">
					<div class="pp-point">
						<h4>{{ entry.heading ?? 'How We Use Your Information' }}</h4>
						{{ entry.description3 }}
						{{ entry.description4 }}
					</div>

					<div class="pp-point">
						<h4>Cookies</h4>
						<div class="pb-20">
							{{ entry.description5 }}
						</div>
						<div class="pp-cookies">
							{{ entry.description6 }}
						</div>
					</div>
				</div>
			</div>

			<div class="pp-div3">
				<div class="container">
					<div class="pp-point">
						<h4>Third-Party Services</h4>
						{{ entry.richText3 }}
						{{ entry.description7 }}
						{{ entry.description8 }}
					</div>

					<div class="pp-point">
						<h4>Information Sharing</h4>
						<div class="pb-20">
							{{ entry.richText4 }}
						</div>
						{{ entry.description9 }}
						{{ entry.description10 }}
					</div>

					<div class="pp-point">
						<h4>Data Security</h4>
						{{ entry.richText5 }}
					</div>

					<div class="pp-point">
						<h4>Your Rights</h4>
						{{ entry.description11 }}
						{{ entry.description12 }}
					</div>

					<div class="pp-point">
						<h4>Data Retention</h4>
						{{ entry.description13 }}
					</div>

					<div class="pp-point">
						<h4>Children's Privacy</h4>
						{{ entry.description14 }}
					</div>

					<div class="pp-point">
						<h4>External Links</h4>
						{{ entry.description15 }}
					</div>

					<div class="pp-point">
						<h4>Changes to This Privacy Policy</h4>
						<p>
							We may update this Privacy Policy from time to time to reflect
														changes in our services, legal requirements, or business
														practices. Any updates will be posted on this page along with
														the revised effective date.
						</p>
					</div>

					<div class="pp-point">
						<h4>Contact Us</h4>
						<p>
							If you have any questions about this Privacy Policy or how
														your information is handled, please contact us.
						</p>
						<div class="pp-contact">
							{% if entry.email is defined and entry.email %}
								<a href="mailto:{{ entry.email }}">
									<span class="pp-span">Email:</span>
									{{ entry.email }}
								</a>
							{% endif %}
							{% if entry.phoneNumber is defined and entry.phoneNumber %}
								<a href="tel:{{ entry.phoneNumber|replace({' ': '', '(': '', ')': '', '-': ''}) }}">
									<span class="pp-span">Phone:</span>
									{{ entry.phoneNumber }}
								</a>
							{% endif %}
							{% if entry.address is defined and entry.address %}
								<a href="#">
									<span class="pp-span">Address:</span>
									{{ entry.address|nl2br }}
								</a>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}
