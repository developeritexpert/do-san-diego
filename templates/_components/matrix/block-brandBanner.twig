{# Craft CMS 5 Matrix Block: Brand Banner ("Discover more. Experience more. DO SAN DIEGO") #}
{% set ribbonMessage = (block is defined and block.ribbonText is defined and block.ribbonText) ? block.ribbonText : "We are your trusted local guide, dedicated to showcasing the finest experiences, attractions, restaurants, and events in the area." %}

<section class="brand-banner-section">
    <div class="brand-banner-container">
        <div class="brand-title-wrap">
            <h2 class="brand-title-main">Discover <span class="text-orange-gradient">more.</span></h2>
            <h2 class="brand-title-sub">Experience <span class="text-orange-gradient">more.</span></h2>
        </div>
        
        <div class="brand-logo-and-ribbon-wrap">
            <!-- DO SAN DIEGO Center Logo matching exact Figma design -->
            <div class="do-san-diego-logo-large">
                <div class="logo-do-line">
                    <div class="d-with-plane">
                        <svg class="airplane-inside" viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                            <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
                        </svg>
                        <span>D</span>
                    </div>
                    <span class="o-letter">O</span>
                </div>
                <div class="logo-subtitle">SAN DIEGO</div>
            </div>

            <!-- Exact Figma SVG Ribbon Asset with Overlay Dynamic TextPath -->
            <div class="curved-ribbon-wrapper">
                <svg viewBox="0 0 1916 641" class="curved-ribbon-svg" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="paint0_linear_230_7" x1="-61" y1="321.516" x2="1941" y2="321.516" gradientUnits="userSpaceOnUse">
                            <stop stop-color="#F26D40"/>
                            <stop offset="1" stop-color="#EE3F66"/>
                        </linearGradient>

                        <!-- Precision Centerline path along ribbon.svg shape -->
                        <path id="figmaRibbonTextPath" d="M -60,542 C 20,500 95,455 210,395 C 235,280 295,100 445,35 C 525,0 560,75 505,185 C 430,305 375,395 440,480 C 585,570 820,580 1200,435 C 1450,335 1670,220 1900,240" fill="none" />
                    </defs>

                    <!-- Exact Ribbon Shape from ribbon.svg -->
                    <g>
                        <path d="M306.435 54.2706C359.165 10.2244 430.376 2.31929 478.591 6.51669L480.869 6.72568L483.493 6.97861L486.06 7.5831C536.936 19.5535 575.486 45.113 591.258 86.1368C606.508 125.803 595.619 167.78 576.34 202.397C538.468 270.398 455.506 334.742 363.684 360.733C363.238 360.982 362.792 361.232 362.346 361.481C388.596 410.029 430.892 460.852 493.325 498.733C590.411 557.641 741.598 588.458 968.125 522.165C1077.41 486.157 1334.53 377.595 1440.96 317.715C1550.96 255.832 1639.14 215.966 1719.81 198.237C1802 180.176 1874.71 185.432 1952.89 210.445L1929.11 284.735C1862.96 263.568 1804.24 259.546 1736.56 274.42C1667.36 289.627 1587.25 324.908 1479.21 385.694C1367.29 448.661 1104.58 559.426 991.867 596.469L991.268 596.666L990.663 596.843C747.842 668.044 572.843 638.217 452.863 565.418C377.551 519.721 326.051 458.352 293.745 398.579C241.871 425.951 187.418 453.453 137.098 478.948C60.9103 517.55 -4.3689 550.864 -40.2773 573.387L-81.7227 507.31C-42.0321 482.414 27.221 447.178 101.845 409.369C154.491 382.695 210.553 354.378 263.199 326.5C260.465 317.691 258.167 309.102 256.285 300.802C224.531 183.411 248.874 102.352 306.435 54.2706ZM470.762 84.1339C433.809 81.1163 386.986 88.6175 356.438 114.134C329.507 136.63 305.288 181.811 331.152 278.849L331.772 281.151L332.008 282.015L332.203 282.889C332.599 284.659 333.022 286.45 333.47 288.261L333.98 287.976L338.704 286.712C414.554 266.425 481.138 213.028 508.195 164.445C521.712 140.175 522.065 123.524 518.453 114.128C515.436 106.281 505.434 92.8141 470.762 84.1339Z" fill="url(#paint0_linear_230_7)"/>
                    </g>

                    <!-- Overlay White Text centered along Precision Centerline -->
                    <text class="ribbon-path-text" fill="#ffffff" font-size="18.5" font-weight="600" letter-spacing="0.5" dy="6">
                        <textPath href="#figmaRibbonTextPath" startOffset="1%">
                            {{ ribbonMessage }}
                        </textPath>
                    </text>
                    </text>
                </svg>
            </div>
        </div>
    </div>
</section>
