<section class="find-section">
	<div class="listing-container">
		<div class="find-wrpper">
			<h2>Find Your Perfect
				<span>Destination</span>
			</h2>


			<div class="find-inner-side">
				<div class="main-iner-wrp">
					<div class="filter-sidebar">
						<div class="filter-block">
							<h4>Type</h4>
							<ul class="filter-list">

								<li>
									<label><input type="checkbox" class="filter-type" value="all" checked>
										All</label>
								</li>

								{% for cat in craft.categories().group('experienceCategories').all() %}
									<li>
										<label>
											<input type="checkbox" class="filter-type" name="type[]" value="{{ cat.slug }}" {% if cat.slug in craft.app.request.getParam('type') %} checked {% endif %}>
											{{ cat.title }}
										</label>
									</li>
								{% endfor %}
							</ul>
						</div>

						<div class="filter-block">
							<h4>Price Range</h4>
							<ul class="filter-list">
								{% for cat in craft.categories().group('priceRange').all() %}
									<label>
										<input type="checkbox" class="filter-price" name="price[]" value="{{ cat.slug }}">
										{{ cat.title }}
									</label>
								{% endfor %}
							</ul>
						</div>
					</div>

					<div class="listing-wrap" id="listings-container">

						{% set destinations = craft.entries().section('destinations').all() %}
						{% for dest in destinations %}
							<div class="listing-card">
								<div class="listing-img">
									{% set img = dest.featuredImage.one() %}
									{% if img %}
										<img src="{{ img.url }}" alt="{{ dest.heading ?? dest.title }}">
									{% else %}
										<div class="promo-img-placeholder" style="height: 100%; min-height: 200px; display: flex; align-items: center; justify-content: center; background: #e0e0e0;">
											<span>No Image</span>
										</div>
									{% endif %}
								</div>
								<div class="listing-details">
									<span class="listing-tag">Listing #{{ loop.index }}</span>
									<h3>{{ dest.heading ?? dest.title }}</h3>
									<p>{{ dest.description|striptags }}</p>
									<a href="{{ dest.buttonUrl ?? dest.url }}" class="cstm-btn">{{ dest.buttonText ?? 'View Details' }}</a>
								</div>
							</div>
						{% endfor %}
					</div>
				</div>
			</div>
		</section>


		<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
		{% js %}
		window.LISTINGS_DATA_URL = "{{ url('where-to-stay/data') }}";
						console.log(window.LISTINGS_DATA_URL);

		{% endjs %}

		{{ craft.app.view.registerJsFile('/assets/js/filter.js') }}
