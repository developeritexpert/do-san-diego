{# Where to Eat - Interactive Restaurant Carousel Component #}
{% set isHome = craft.app.request.segments|length == 0 %}

{% set categories = craft.entries().section('restaurants').all() %}
{% if not isHome %}
	{% if block.categories is defined and block.categories|length %}
		{% set categories = block.categories %}
	{% elseif entry is defined and entry.category2 is defined and entry.category2.all()|length %}
		{% set categories = entry.category2.all() %}
	{% elseif entry is defined and entry.category is defined and entry.category.all()|length %}
		{% set categories = entry.category.all() %}
	{% endif %}
{% endif %}

{% set sectionHeading = block.heading ?? 'Where to Eat' %}
{% if not isHome %}
	{% if entry is defined and entry.heading2 is defined and entry.heading2 %}
		{% set sectionHeading = entry.heading2 %}
	{% elseif entry is defined and entry.heading is defined and entry.heading %}
		{% set sectionHeading = entry.heading %}
	{% endif %}
{% endif %}

<section class="section-where-to-eat {{ isHome ? '' : 'inner-eat-sec' }}">
	<div class="eat-container">
		<h2 class="section-title text-center">
			{{ sectionHeading }}
		</h2>
		<div class="service-slider-sec">
			<div class="srvce-inner">
				<div class="main-wrap-slider">
					{% for cat in categories %}
						{% set imgUrl = null %}

						{% if cat.getFieldLayout is defined %}
							{% set itemFieldLayout = cat.getFieldLayout() %}
							{% if itemFieldLayout and itemFieldLayout.getFieldByHandle('featuredImage') and cat.getFieldValue('featuredImage') %}
								{% set imgObj = cat.getFieldValue('featuredImage').one() %}
								{% if imgObj %}
									{% set imgUrl = imgObj.getUrl() %}
								{% endif %}
							{% elseif itemFieldLayout and itemFieldLayout.getFieldByHandle('assets') and cat.getFieldValue('assets') %}
								{% set imgObj = cat.getFieldValue('assets').one() %}
								{% if imgObj %}
									{% set imgUrl = imgObj.getUrl() %}
								{% endif %}
							{% endif %}
						{% endif %}

						<div class="slide-wrap">
							<a href="javascript:void(0);" class="srvce-card-link" style="text-decoration: none; color: inherit;">

								<div class="srvce-img">
									{% if imgUrl %}
										<img src="{{ imgUrl }}" alt="{{ cat.title }}" loading="lazy"/>
									{% else %}
										<img src="{{ alias('@web/assets/images/restaurant-1.png') }}" alt="{{ cat.title }}" loading="lazy"/>
									{% endif %}
								</div>
								<div class="srvce-cntnt">
									<h5>{{ cat.title }}</h5>
								</div>
							</a>
						</div>
					{% endfor %}
				</div>
				<div class="progress-bar">
					<div class="bar"></div>
				</div>
			</div>
		</div>
	</div>
</section>
