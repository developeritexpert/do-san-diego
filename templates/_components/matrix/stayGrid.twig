{# Where to Stay Component matching Figma design screenshot #}
{% set stays = craft.entries().section('stays').all() %}

{% set whatToDoPage = craft.entries().slug('what-to-do').one() %}

<section class="section-where-to-stay {{ craft.app.request.segments|length == 0 ? 'border' : 'inner-page-sec' }}">


	<div class="stay-img">
		{% if (craft.app.request.segments|length) == 0 %}
			<img src="{{ getenv( 'PRIMARY_SITE_URL' ) }}assets/images/stay-img.png"/>
		{% else %}
			<img src="{{ getenv('PRIMARY_SITE_URL') }}assets/images/phad.png" class="not-homepage"/>
		{% endif %}

		<img src="{{ getenv('PRIMARY_SITE_URL') }}assets/images/tree-img.png" class="top-abs-img"/>

		<div class="absolute-txt-img">
			<img src="{{ getenv( 'PRIMARY_SITE_URL' ) }}assets/images/DO-San-Diego-lyt.png" alt="DO San Diego" loading="lazy"/>
		</div>
	</div>

	{% if (craft.app.request.segments|length) == 0 %}
		<div
			class="stay-container">
			<!-- Left Title & Navigation Buttons Column -->
			<div class="stay-header-col">
				<h2 class="stay-section-title">
					Where<br/>to
					<span class="text-orange">Stay</span>
				</h2>
				<div class="stay-nav-buttons">
					<button class="stay-nav-btn stay-prev-btn" id="stayPrevBtn" aria-label="Previous Stay">
						&larr;
					</button>
					<button class="stay-nav-btn stay-next-btn" id="stayNextBtn" aria-label="Next Stay">
						&rarr;
					</button>
				</div>
			</div>

			<!-- Right 3-Cards Carousel Viewport Column -->
			<div class="stay-carousel-viewport" id="stayCarouselViewport">
				<div class="stay-carousel-track" id="stayCarouselTrack">
					{% set items = stays|length
						? stays
						: [
							{
								title: 'Bed & Breakfast',
								imgUrl: 'https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=800&q=80',
								url: '#'
							},
							{
								title: 'Hotels',
								imgUrl: 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80',
								url: '#'
							},
							{
								title: 'Motels',
								imgUrl: 'https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?auto=format&fit=crop&w=800&q=80',
								url: '#'
							}
						]
					%}

					{% for stayItem in items %}
						{% set imgUrl = null %}
						{% set itemTitle = stayItem.title ?? 'Stays' %}
						{% set itemLink = stayItem.url ?? (stayItem.linkto is defined and stayItem.linkto.value is defined ? stayItem.linkto.value : '#') %}

						{% if stayItem.getFieldLayout is defined %}
							{% set itemFieldLayout =
								stayItem.getFieldLayout()
							%}
							{% if
								itemFieldLayout
									and itemFieldLayout.getFieldByHandle(
										'featuredImage'
									)
									and stayItem.getFieldValue(
										'featuredImage'
									) %}
								{% set imgObj =
									stayItem.getFieldValue(
										'featuredImage'
									).one()
								%}
								{% if imgObj %}
									{% set imgUrl = imgObj.getUrl() %}
								{% endif %}
							{% elseif
								itemFieldLayout
									and itemFieldLayout.getFieldByHandle(
										'assets'
									)
									and stayItem.getFieldValue('assets') %}
								{% set imgObj =
									stayItem.getFieldValue('assets').one()
								%}
								{% if imgObj %}
									{% set imgUrl = imgObj.getUrl() %}
								{% endif %}
							{% endif %}
						{% elseif stayItem.imgUrl is defined %}
							{% set imgUrl = stayItem.imgUrl %}
						{% endif %}

						<div class="stay-card-item">
							<a href="{{ itemLink }}" class="stay-card-inner">
								<div class="stay-card-media">
									{% if imgUrl %}
										<img src="{{ imgUrl }}" alt="{{ itemTitle }}" loading="lazy"/>
									{% else %}
										<div class="stay-placeholder">
											<span>{{ itemTitle }}</span>
										</div>
									{% endif %}
									<div class="stay-card-overlay"></div>
									<div class="stay-card-footer">
										<h3 class="stay-card-title">
											{{ itemTitle }}
										</h3>
										<span class="stay-card-arrow">
											&rarr;
										</span>
									</div>
								</div>
							</a>
						</div>
					{% endfor %}
				</div>
			</div>
		</div>
	{% endif %}
</section>
