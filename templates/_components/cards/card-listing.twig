{# Card Listing Component #}
{% set item = entry ?? cardItem ?? null %}
{% if item %}
<article class="card card-listing">
    {% if item.featuredImage is defined and item.featuredImage.one() %}
        <div class="card-media">
            <img src="{{ item.featuredImage.one().getUrl() }}" alt="{{ item.title }}" loading="lazy" />
        </div>
    {% endif %}
    <div class="card-body">
        <h3 class="card-title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
        {% if item.locationName is defined %}
            <p class="card-location">{{ item.locationName }}</p>
        {% endif %}
    </div>
</article>
{% endif %}
