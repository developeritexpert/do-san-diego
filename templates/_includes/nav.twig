<div class="menu-ryt-cont">
	<div class="close-btn-cont">
		<img src="{{ alias('@web/') }}assets/images/cross.png">
	</div>
	<ul class="menu-list-cont">
		{% set headerObj = (header is defined and header) ? header : craft.app.globals.getSetByHandle('header') %}
		{% set navItems = headerObj and headerObj.headerNaviagation is defined ? headerObj.headerNaviagation.all() : [] %}

		{% if navItems|length %}
			{% for item in navItems %}
				{% set linkUrl = item.linkUrl is defined and item.linkUrl ? (item.linkUrl.getUrl() ?? item.linkUrl.url ?? '#') : '#' %}
				<li class="menu-list">
					<a href="{{ linkUrl }}" class="hdr-menu-link">{{ item.title }}</a>
				</li>
			{% endfor %}
		{% else %}
			<li class="menu-list">
				<a href="#" class="hdr-menu-link">What to Do</a>
			</li>
			<li class="menu-list">
				<a href="#" class="hdr-menu-link">Where to Eat</a>
			</li>
			<li class="menu-list">
				<a href="#" class="hdr-menu-link">Where to Stay</a>
			</li>
		{% endif %}
	</ul>
	<div class="footer-address">
		{% set addressData = null %}
		{% if headerObj and headerObj.address is defined and headerObj.address %}
			{% if headerObj.address.richText is defined %}
				{% set addressData = headerObj.address.richText %}
			{% else %}
				{% set addressData = headerObj.address %}
			{% endif %}
		{% endif %}

		{% if addressData %}
			{{ addressData|raw }}
		{% else %}
			<p>
				<strong>Town Of Oro Valley</strong>
				<br>11000 N. La Cañada Drive Oro Valley AZ, 85737
			</p>
		{% endif %}

		{% if headerObj and headerObj.phoneNumber is defined and headerObj.phoneNumber %}
			<a class="inner-link" href="tel:{{ headerObj.phoneNumber|replace({' ': '', '(': '', ')': '', '-': ''}) }}">
				<strong>{{ headerObj.phoneNumber }}</strong>
			</a>
		{% else %}
			<a class="inner-link" href="tel:(520) 229-4700">
				<strong>(520) 229-4700</strong>
			</a>
		{% endif %}

		<div class="social-links">
			<h6>Follow Us!</h6>
			<div class="social-link-cont">
				{% set fbUrl = '#' %}
				{% set instaUrl = '#' %}
				{% set threadsUrl = '#' %}

				{% if headerObj and headerObj.socialLinks is defined %}
					{% for social in headerObj.socialLinks.all() %}
						{% set linkUrl = social.linkUrl.url ?? social.linkUrl ?? '#' %}
						{% set title = social.title|lower %}
						
						{% if 'face' in title or 'fb' in title %}
							{% set fbUrl = linkUrl %}
						{% elseif 'insta' in title or 'ig' in title %}
							{% set instaUrl = linkUrl %}
						{% elseif 'thread' in title or 'tread' in title %}
							{% set threadsUrl = linkUrl %}
						{% endif %}
					{% endfor %}
				{% endif %}

				<a href="{{ fbUrl }}" class="s-link" {% if fbUrl != '#' %}target="_blank" rel="noopener"{% endif %}>
					<img src="{{ alias('@web/') }}assets/images/facebook.png">
				</a>
				<a href="{{ instaUrl }}" class="s-link" {% if instaUrl != '#' %}target="_blank" rel="noopener"{% endif %}>
					<img src="{{ alias('@web/') }}assets/images/insta.png">
				</a>
				<a href="{{ threadsUrl }}" class="s-link" {% if threadsUrl != '#' %}target="_blank" rel="noopener"{% endif %}>
					<img src="{{ alias('@web/') }}assets/images/treads.png">
				</a>
			</div>
		</div>
	</div>
</div>
