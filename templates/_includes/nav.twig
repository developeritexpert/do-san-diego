<div class="menu-ryt-cont">
	<div class="close-btn-cont">
		<img src="{{ getenv('PRIMARY_SITE_URL') }}assets/images/cross.png">
	</div>
	<ul class="menu-list-cont">
		{% set headerObj = (header is defined and header) ? header : craft.app.globals.getSetByHandle('header') %}
		{% set navItems = headerObj and headerObj.headerNaviagation is defined ? headerObj.headerNaviagation.all() : [] %}

		{% if navItems|length %}
			{% for item in navItems %}
				{% set linkUrl = item.linkUrl is defined and item.linkUrl ? (item.linkUrl.getUrl() ?? item.linkUrl.url ?? '#') : '#' %}
				<li class="menu-list">
					<a href="{{ linkUrl }}" class="hdr-menu-link">{{ item.title }}</a>
				</li>
			{% endfor %}
		{% else %}
			<li class="menu-list">
				<a href="#" class="hdr-menu-link">What to Do</a>
			</li>
			<li class="menu-list">
				<a href="#" class="hdr-menu-link">Where to Eat</a>
			</li>
			<li class="menu-list">
				<a href="#" class="hdr-menu-link">Where to Stay</a>
			</li>
		{% endif %}
	</ul>
	<div class="footer-address">
		<p>
			<strong>Town Of Oro Valley</strong>
			<br>11000 N. La Cañada Drive Oro Valley AZ, 85737
		</p>
		<a class="inner-link" href="tel:(520) 229-4700">
			<strong>(520) 229-4700</strong>
		</a>
		<div class="social-links">
			<h6>Follow Us!</h6>
			<div class="social-link-cont">
				<a href="#" class="s-link">
					<img src="{{ getenv('PRIMARY_SITE_URL') }}assets/images/facebook.png">
				</a>
				<a href="#" class="s-link">
					<img src="{{ getenv('PRIMARY_SITE_URL') }}assets/images/insta.png">
				</a>
				<a href="#" class="s-link">
					<img src="{{ getenv('PRIMARY_SITE_URL') }}assets/images/treads.png">
				</a>
			</div>
		</div>
	</div>
</div>
