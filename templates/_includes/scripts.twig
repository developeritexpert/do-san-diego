{# Global JavaScript assets #}

{% set currentSlug = craft.app.request.pathInfo %}

{% if
	currentSlug == 'where-to-stay'
		or (entry is defined
			and (entry.section.type|default('')) in ['channel', 'structure']) %}
	<script src="https://cdnjs.ajax.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

	<!-- bootstrap -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
{% endif %}
<script defer src="{{ alias('@web/') }}assets/js/main.js?v={{ now.timestamp }}"></script>
<script defer src="{{ alias('@web/') }}assets/js/custom.js?v={{ now.timestamp }}"></script>
